#!/usr/bin/env bash
set -euo pipefail

environment_file="${ENV_FILE:-.env.production}"
backup_directory="${BACKUP_DIR:-backups}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_path="${backup_directory}/prompt_hub_${timestamp}.sql.gz"

if [[ ! -f "$environment_file" ]]; then
  echo "No existe $environment_file. Copia .env.production.example y configura sus valores." >&2
  exit 1
fi

mkdir -p "$backup_directory"
docker compose --env-file "$environment_file" -f compose.production.yml exec -T db \
  sh -c 'MYSQL_PWD="$MYSQL_PASSWORD" mysqldump --single-transaction --quick --lock-tables=false -h localhost -u"$MYSQL_USER" "$MYSQL_DATABASE"' \
  | gzip > "$backup_path"

echo "Backup creado: $backup_path"
