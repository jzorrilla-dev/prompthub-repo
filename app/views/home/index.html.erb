<% content_for :title, "Prompts que evolucionan" %>

<section class="relative isolate overflow-hidden border-b border-slate-200 bg-white">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_15%_20%,rgba(99,102,241,0.14),transparent_28%),radial-gradient(circle_at_85%_30%,rgba(245,158,11,0.12),transparent_22%)]"></div>
  <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.05fr_.95fr] lg:px-8 lg:py-32">
    <div>
      <p class="mb-5 inline-flex rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-bold uppercase tracking-widest text-indigo-700">Biblioteca colaborativa de prompts</p>
      <h1 class="max-w-3xl text-5xl font-black leading-[1.02] tracking-[-0.045em] text-slate-950 sm:text-6xl lg:text-7xl">No guardes solo el prompt. <span class="text-indigo-600">Guarda cómo llegó a funcionar.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">Comparte prompts, documenta resultados y conserva cada versión. Una memoria colectiva para quienes construyen con inteligencia artificial.</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <%= link_to "Explorar prompts", prompts_path, class: "rounded-xl bg-indigo-600 px-6 py-3.5 text-center font-bold text-white shadow-lg shadow-indigo-200 hover:bg-indigo-700" %>
        <%= link_to(authenticated? ? "Crear un prompt" : "Únete gratis", authenticated? ? new_prompt_path : new_registration_path, class: "rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-center font-bold text-slate-800 hover:border-slate-400 hover:bg-slate-50") %>
      </div>
      <div class="mt-10 flex gap-8 text-sm text-slate-500">
        <p><strong class="block text-2xl text-slate-950"><%= @prompt_count %></strong> prompts públicos</p>
        <p><strong class="block text-2xl text-slate-950"><%= @creator_count %></strong> creadores</p>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-xl">
      <div class="absolute -inset-6 -z-10 rotate-2 rounded-[2rem] bg-indigo-100/70"></div>
      <div class="rounded-[1.75rem] border border-slate-200 bg-slate-950 p-3 shadow-2xl shadow-slate-300">
        <div class="flex items-center gap-1.5 px-3 py-2">
          <span class="size-2.5 rounded-full bg-rose-400"></span><span class="size-2.5 rounded-full bg-amber-400"></span><span class="size-2.5 rounded-full bg-emerald-400"></span>
          <span class="ml-3 text-xs font-medium text-slate-500">prompt.md · v3</span>
        </div>
        <div class="rounded-2xl bg-slate-900 p-6 font-mono text-sm leading-7 text-slate-300 sm:p-8">
          <p><span class="text-fuchsia-400"># Rol</span><br>Actúa como un revisor técnico exigente y constructivo.</p>
          <p class="mt-4"><span class="text-cyan-400"># Contexto</span><br>El lector conoce los fundamentos, pero necesita decisiones claras.</p>
          <p class="mt-4"><span class="text-amber-300"># Resultado</span><br>Entrega hallazgos priorizados, evidencia y una corrección concreta.</p>
          <div class="mt-6 flex items-center justify-between border-t border-slate-700 pt-4 text-xs text-slate-500"><span>+ 2 resultados</span><span class="text-emerald-400">● verificado</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mb-9 flex items-end justify-between gap-4">
    <div><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Recién actualizados</p><h2 class="mt-2 text-3xl font-black tracking-tight">Ideas listas para reutilizar</h2></div>
    <%= link_to "Ver todos →", prompts_path, class: "text-sm font-bold text-indigo-700 hover:text-indigo-900" %>
  </div>
  <% if @featured_prompts.any? %>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><%= render partial: "shared/prompt_card", collection: @featured_prompts, as: :prompt %></div>
  <% else %>
    <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <p class="text-4xl">✦</p><h3 class="mt-4 text-xl font-bold">La biblioteca está esperando su primer hallazgo.</h3>
      <p class="mt-2 text-slate-500">Publica el primer prompt y documenta qué lo hizo funcionar.</p>
    </div>
  <% end %>
</section>

<section class="bg-indigo-600 text-white">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-3 lg:px-8">
    <% [["01", "Versiona", "Conserva cada mejora y explica por qué cambió."], ["02", "Demuestra", "Adjunta resultados reales, no solo promesas."], ["03", "Construye", "Haz fork de una idea y llévala a otro contexto."]].each do |number, title, text| %>
      <div><span class="text-sm font-black text-indigo-200"><%= number %></span><h3 class="mt-3 text-xl font-bold"><%= title %></h3><p class="mt-2 leading-7 text-indigo-100"><%= text %></p></div>
    <% end %>
  </div>
</section>
