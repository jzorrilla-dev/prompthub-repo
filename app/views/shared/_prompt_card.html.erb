<article class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-xl hover:shadow-indigo-100/50">
  <div class="mb-4 flex items-center justify-between gap-3">
    <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700"><%= prompt.category&.name || "General" %></span>
    <span class="text-xs font-medium text-slate-400"><%= time_ago_in_words(prompt.updated_at) %></span>
  </div>
  <h2 class="text-lg font-bold leading-snug tracking-tight text-slate-950 group-hover:text-indigo-700">
    <%= link_to prompt.title, prompt %>
  </h2>
  <p class="mt-2 line-clamp-3 flex-1 text-sm leading-6 text-slate-600"><%= prompt.description.presence || truncate(prompt.content, length: 150) %></p>
  <div class="mt-5 flex flex-wrap gap-1.5">
    <% prompt.tags.first(3).each do |tag| %>
      <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">#<%= tag.name %></span>
    <% end %>
  </div>
  <div class="mt-5 flex items-center gap-2 border-t border-slate-100 pt-4">
    <%= link_to user_path(prompt.user), aria: { label: "Ver perfil de #{prompt.user.name}" }, class: "grid size-7 place-items-center rounded-full bg-amber-100 text-[10px] font-black text-amber-800 hover:ring-2 hover:ring-amber-200" do %><%= initials(prompt.user.name) %><% end %>
    <%= link_to prompt.user.name, user_path(prompt.user), class: "text-xs font-semibold text-slate-600 hover:text-indigo-700" %>
    <% if prompt.ai_model.present? %>
      <span class="ml-auto text-xs text-slate-400"><%= prompt.ai_model %></span>
    <% end %>
  </div>
</article>
