<% content_for :title, @user.name %>

<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
      <span class="grid size-20 shrink-0 place-items-center rounded-3xl bg-amber-100 text-2xl font-black text-amber-800"><%= initials(@user.name) %></span>
      <div><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Perfil de creador</p><h1 class="mt-2 text-4xl font-black tracking-tight"><%= @user.name %></h1><p class="mt-2 text-slate-500">Comparte ideas, experimentos y prompts que vale la pena conservar.</p></div>
    </div>
    <div class="mt-8 flex flex-wrap gap-8"><% [["Prompts públicos", @stats[:prompts]], ["Favoritos recibidos", @stats[:received_favorites]], ["Comentarios", @stats[:comments]], ["Forks creados", @stats[:forks]]].each do |label, value| %><div><strong class="block text-2xl font-black text-slate-950"><%= value %></strong><span class="text-xs font-semibold text-slate-500"><%= label %></span></div><% end %></div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <div class="mb-6 flex items-end justify-between"><div><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Biblioteca pública</p><h2 class="mt-2 text-2xl font-black">Prompts de <%= @user.name.split.first %></h2></div></div>
  <% if @prompts.any? %><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><%= render partial: "shared/prompt_card", collection: @prompts, as: :prompt %></div><% else %><div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center text-slate-500">Este creador todavía no tiene prompts públicos.</div><% end %>
</section>
