<% content_for :title, "Crear cuenta" %>
<div class="mx-auto max-w-lg px-4 py-16 sm:py-24">
  <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-xl shadow-slate-200/60 sm:p-9">
    <p class="text-sm font-bold text-indigo-600">Empieza a documentar</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight">Crea tu cuenta</h1>
    <p class="mt-3 text-sm leading-6 text-slate-500">Tu perfil será la firma de los prompts y versiones que compartas.</p>
    <%= form_with model: @user, url: registration_path, class: "mt-8 space-y-5" do |form| %>
      <%= render "shared/errors", object: @user %>
      <div><%= form.label :name, "Nombre", class: "form-label" %><%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "form-input" %></div>
      <div><%= form.label :email_address, "Correo electrónico", class: "form-label" %><%= form.email_field :email_address, required: true, autocomplete: "email", class: "form-input" %></div>
      <div><%= form.label :password, "Contraseña (mínimo 8 caracteres)", class: "form-label" %><%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "form-input" %></div>
      <div><%= form.label :password_confirmation, "Confirmar contraseña", class: "form-label" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-input" %></div>
      <%= form.submit "Crear mi cuenta", class: "btn-primary w-full cursor-pointer" %>
    <% end %>
  </div>
</div>
