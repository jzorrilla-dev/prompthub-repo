<% content_for :title, "Ingresar" %>
<div class="mx-auto max-w-md px-4 py-16 sm:py-24">
  <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-xl shadow-slate-200/60 sm:p-9">
    <p class="text-sm font-bold text-indigo-600">Bienvenido de vuelta</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight">Ingresa a tu biblioteca</h1>
    <%= form_with url: session_path, class: "mt-8 space-y-5" do |form| %>
      <div><%= form.label :email_address, "Correo electrónico", class: "form-label" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "form-input" %></div>
      <div><%= form.label :password, "Contraseña", class: "form-label" %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "form-input" %></div>
      <%= form.submit "Ingresar", class: "btn-primary w-full cursor-pointer" %>
    <% end %>
    <p class="mt-6 text-center text-sm text-slate-500">¿Aún no tienes cuenta? <%= link_to "Créala aquí", new_registration_path, class: "font-bold text-indigo-700" %></p>
  </div>
</div>
