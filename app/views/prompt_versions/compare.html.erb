<% content_for :title, "Comparar versiones de #{@prompt.title}" %>
<div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
  <%= link_to "← Volver al prompt", @prompt, class: "text-sm font-bold text-indigo-700" %>
  <div class="mt-7"><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Historial visual</p><h1 class="mt-2 text-4xl font-black tracking-tight">Comparar versiones</h1><p class="mt-3 text-slate-500">Revisa qué cambió entre dos revisiones del prompt.</p></div>
  <%= form_with url: compare_prompt_versions_path(@prompt), method: :get, class: "mt-8 grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |form| %>
    <div><%= form.label :from, "Versión anterior", class: "form-label" %><%= form.collection_select :from, @versions, :id, ->(version) { "v#{version.number} · #{l(version.created_at, format: :short)}" }, { selected: @from.id }, class: "form-input" %></div>
    <div><%= form.label :to, "Versión nueva", class: "form-label" %><%= form.collection_select :to, @versions, :id, ->(version) { "v#{version.number} · #{l(version.created_at, format: :short)}" }, { selected: @to.id }, class: "form-input" %></div>
    <%= form.submit "Comparar", class: "btn-primary cursor-pointer" %>
  <% end %>
  <div class="mt-8 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4"><p class="text-sm font-bold">v<%= @from.number %> → v<%= @to.number %></p><div class="flex gap-3 text-xs font-bold"><span class="text-rose-700">− Eliminado</span><span class="text-emerald-700">+ Agregado</span></div></div>
    <div class="overflow-x-auto bg-slate-950 p-2 font-mono text-sm leading-7"><% @diff_rows.each do |row| %><div class="whitespace-pre-wrap px-3 <%= { same: "text-slate-400", removed: "bg-rose-950/70 text-rose-200", added: "bg-emerald-950/70 text-emerald-200" }.fetch(row[:type]) %>"><span class="mr-3 inline-block w-4 select-none text-center text-slate-500"><%= { same: " ", removed: "−", added: "+" }.fetch(row[:type]) %></span><%= row[:text] %></div><% end %></div>
  </div>
</div>
