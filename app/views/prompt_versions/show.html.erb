<% content_for :title, "#{@prompt.title} v#{@version.number}" %>
<div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
  <%= link_to "← Volver al prompt actual", @prompt, class: "text-sm font-bold text-indigo-700" %>
  <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Versión <%= @version.number %></p><h1 class="mt-2 text-3xl font-black"><%= @version.title %></h1></div><p class="text-sm text-slate-500"><%= l(@version.created_at, format: :long) %></p></div>
  <% if @version.change_note.present? %><div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"><strong>Cambio:</strong> <%= @version.change_note %></div><% end %>
  <div class="mt-8 overflow-hidden rounded-3xl border border-slate-800 bg-slate-950"><div class="border-b border-slate-800 px-5 py-3 font-mono text-xs text-slate-400">prompt-v<%= @version.number %>.md</div><pre class="whitespace-pre-wrap p-6 font-mono text-sm leading-7 text-slate-200 sm:p-8"><%= @version.content %></pre></div>
</div>
