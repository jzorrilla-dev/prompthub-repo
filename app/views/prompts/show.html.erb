<% content_for :title, @prompt.title %>

<article class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div>
      <div class="mb-5 flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700"><%= @prompt.category&.name || "General" %></span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600"><%= visibility_label(@prompt) %></span>
        <% if @prompt.forked_from %><%= link_to "Fork de #{@prompt.forked_from.title}", @prompt.forked_from, class: "text-xs font-bold text-amber-700 hover:underline" %><% end %>
      </div>
      <h1 class="text-4xl font-black leading-tight tracking-[-0.03em] sm:text-5xl"><%= @prompt.title %></h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600"><%= @prompt.description %></p>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <span class="grid size-9 place-items-center rounded-full bg-amber-100 text-xs font-black text-amber-800"><%= initials(@prompt.user.name) %></span><strong class="text-slate-800"><%= @prompt.user.name %></strong><span>·</span><span>Actualizado <%= time_ago_in_words(@prompt.updated_at) %></span>
      </div>

      <section class="mt-10 overflow-hidden rounded-3xl border border-slate-800 bg-slate-950 shadow-xl" data-controller="clipboard">
        <div class="flex items-center justify-between border-b border-slate-800 px-5 py-3"><span class="font-mono text-xs text-slate-400">prompt.md</span><button type="button" class="rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-bold text-white hover:bg-indigo-600" data-action="clipboard#copy" data-clipboard-target="button">Copiar prompt</button></div>
        <pre class="max-h-[44rem] overflow-auto whitespace-pre-wrap p-6 font-mono text-sm leading-7 text-slate-200 sm:p-8" data-clipboard-target="source"><%= @prompt.content %></pre>
      </section>

      <% if @prompt.prompt_results.any? %>
        <section class="mt-10"><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Evidencia</p><h2 class="mt-2 text-2xl font-black">Resultados compartidos</h2><div class="mt-5 space-y-4"><% @prompt.prompt_results.each do |result| %><div class="rounded-2xl border border-slate-200 bg-white p-5"><h3 class="text-sm font-bold text-slate-700"><%= result.label.presence || "Resultado" %></h3><pre class="mt-3 whitespace-pre-wrap font-sans text-sm leading-7 text-slate-600"><%= result.content %></pre></div><% end %></div></section>
      <% end %>

      <section class="mt-10" aria-labelledby="comments-heading">
        <div class="flex items-end justify-between gap-4"><div><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Conversación</p><h2 id="comments-heading" class="mt-2 text-2xl font-black">Comentarios <span class="text-lg font-medium text-slate-400">(<%= @comments.size %>)</span></h2></div></div>
        <% if authenticated? && PromptPolicy.new(current_user, @prompt).comment? %>
          <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-5"><%= render "comments/form", prompt: @prompt, comment: @comment %></div>
        <% elsif !authenticated? %>
          <p class="mt-4 text-sm text-slate-500"><%= link_to "Ingresa", new_session_path, class: "font-bold text-indigo-700 hover:underline" %> para participar de la conversación.</p>
        <% end %>
        <div id="comments" class="mt-5 space-y-4">
          <% if @comments.any? %>
            <%= render partial: "comments/comment", collection: @comments, as: :comment %>
          <% else %>
            <p class="rounded-2xl border border-dashed border-slate-300 px-5 py-8 text-center text-sm text-slate-500">Sé la primera persona en compartir una observación.</p>
          <% end %>
        </div>
      </section>
    </div>

    <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Acciones</p>
        <div class="mt-4 space-y-2">
          <% if @prompt.user == current_user %><%= link_to "Editar y versionar", edit_prompt_path(@prompt), class: "btn-primary block text-center" %><%= button_to "Eliminar", @prompt, method: :delete, data: { turbo_confirm: "¿Eliminar este prompt y todo su historial?" }, class: "w-full rounded-xl border border-rose-200 px-4 py-2.5 text-sm font-bold text-rose-700 hover:bg-rose-50" %><% elsif authenticated? %><%= button_to "Crear un fork", fork_prompt_path(@prompt), method: :post, class: "btn-primary w-full" %><% else %><%= link_to "Ingresa para hacer fork", new_session_path, class: "btn-primary block text-center" %><% end %>
          <% if authenticated? && @prompt.public_prompt? %><%= render "favorite_button", prompt: @prompt, favorited: current_user.favorites.exists?(prompt: @prompt) %><% end %>
        </div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <dl class="space-y-4 text-sm"><div><dt class="text-xs font-bold uppercase tracking-wider text-slate-400">Modelo probado</dt><dd class="mt-1 font-semibold"><%= @prompt.ai_model.presence || "No especificado" %></dd></div><div><dt class="text-xs font-bold uppercase tracking-wider text-slate-400">Etiquetas</dt><dd class="mt-2 flex flex-wrap gap-1.5"><% @prompt.tags.each do |tag| %><span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-medium">#<%= tag.name %></span><% end %></dd></div><div><dt class="text-xs font-bold uppercase tracking-wider text-slate-400">Forks</dt><dd class="mt-1 font-semibold"><%= @prompt.forks.count %></dd></div><div><dt class="text-xs font-bold uppercase tracking-wider text-slate-400">Favoritos</dt><dd class="mt-1 font-semibold"><%= @prompt.favorites.count %></dd></div></dl>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <div class="flex items-center justify-between"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Historial</p><span class="text-xs text-slate-400"><%= @prompt.prompt_versions.count %> versiones</span></div>
        <ol class="mt-4 space-y-3"><% @versions.each do |version| %><li><%= link_to prompt_version_path(@prompt, version), class: "flex items-start gap-3 rounded-lg p-2 hover:bg-slate-50" do %><span class="grid size-7 shrink-0 place-items-center rounded-full bg-indigo-50 text-xs font-black text-indigo-700">v<%= version.number %></span><span><strong class="block text-sm"><%= version.change_note.presence || "Versión #{version.number}" %></strong><small class="text-slate-400"><%= l(version.created_at, format: :short) %></small></span><% if version == @versions.first %><span class="ml-auto rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-700">actual</span><% end %><% end %></li><% end %></ol>
      </div>
    </aside>
  </div>
</article>
