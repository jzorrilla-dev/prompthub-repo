<% content_for :title, params[:mine].present? ? "Mis prompts" : "Explorar" %>

<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div><p class="text-sm font-bold uppercase tracking-widest text-indigo-600"><%= params[:mine].present? ? "Tu espacio" : "Biblioteca abierta" %></p><h1 class="mt-2 text-4xl font-black tracking-tight"><%= params[:mine].present? ? "Mis prompts" : "Encuentra una mejor forma de pedirlo" %></h1></div>
      <%= form_with url: prompts_path, method: :get, class: "flex w-full max-w-xl gap-2", data: { turbo_frame: "prompt_results" } do |form| %>
        <%= form.hidden_field :mine, value: params[:mine] if params[:mine].present? %>
        <%= form.search_field :q, value: params[:q], placeholder: "Busca por idea, etiqueta o contenido…", class: "form-input !mt-0" %>
        <%= form.submit "Buscar", class: "btn-primary cursor-pointer" %>
      <% end %>
    </div>
    <div class="mt-7 flex flex-wrap gap-2">
      <%= link_to "Todas", prompts_path(q: params[:q], mine: params[:mine]), class: "filter-pill #{'filter-pill-active' if params[:category_id].blank?}" %>
      <% @categories.each do |category| %>
        <%= link_to category.name, prompts_path(q: params[:q], mine: params[:mine], category_id: category.id), class: "filter-pill #{'filter-pill-active' if params[:category_id].to_s == category.id.to_s}" %>
      <% end %>
    </div>
  </div>
</section>

<%= turbo_frame_tag "prompt_results", target: "_top", data: { turbo_action: "advance" } do %>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <% if @prompts.any? %>
      <div class="mb-5 flex items-center justify-between"><p class="text-sm text-slate-500"><strong class="text-slate-950"><%= @total_prompts %></strong> resultados</p><%= link_to "+ Nuevo prompt", new_prompt_path, class: "text-sm font-bold text-indigo-700", data: { turbo_frame: "_top" } if authenticated? %></div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><%= render partial: "shared/prompt_card", collection: @prompts, as: :prompt %></div>
      <%= render "shared/pagination" %>
    <% else %>
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-20 text-center"><p class="text-4xl">⌕</p><h2 class="mt-4 text-xl font-bold">No encontramos coincidencias</h2><p class="mt-2 text-slate-500">Prueba otra búsqueda o crea el prompt que falta.</p></div>
    <% end %>
  </section>
<% end %>
