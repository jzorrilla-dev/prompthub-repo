  <div class="mb-9"><p class="text-sm font-bold uppercase tracking-widest text-indigo-600">Nueva versión</p><h1 class="mt-2 text-4xl font-black tracking-tight">Mejora sin perder la historia</h1><p class="mt-3 max-w-2xl leading-7 text-slate-500">Al guardar, PromptHub conservará una instantánea de esta revisión.</p></div>
  <%= render "form", prompt: @prompt %>
</div>
