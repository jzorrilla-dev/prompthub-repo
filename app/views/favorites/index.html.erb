<% content_for :title, "Mis favoritos" %>

<section class="border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-widest text-amber-600">Tu biblioteca personal</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight">Mis favoritos</h1>
    <p class="mt-3 max-w-2xl leading-7 text-slate-500">Prompts que quieres conservar a mano para volver a ellos cuando los necesites.</p>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <% if @prompts.any? %>
    <p class="mb-5 text-sm text-slate-500"><strong class="text-slate-950"><%= @total_prompts %></strong> prompts guardados</p>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><%= render partial: "shared/prompt_card", collection: @prompts, as: :prompt %></div>
    <%= render "shared/pagination" %>
  <% else %>
    <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-20 text-center">
      <p class="text-4xl text-amber-500">☆</p>
      <h2 class="mt-4 text-xl font-bold">Todavía no guardaste ningún prompt</h2>
      <p class="mt-2 text-slate-500">Explora la biblioteca y marca las ideas que quieras volver a encontrar.</p>
      <%= link_to "Explorar prompts", prompts_path, class: "btn-primary mt-6 inline-block" %>
    </div>
  <% end %>
</section>
